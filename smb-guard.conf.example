# smb-guard configuration — the single definition point for environment-specific values
#
# Deployment paths:
#   host (macOS)   /usr/local/etc/smb-guard.conf
#   guest (Linux)  /etc/smb-guard.conf
#
# install.sh copies this file to both sides and generates the LaunchDaemon plists,
# the systemd units, the newsyslog configuration and the Samba share definition
# from its values. Re-run install after changing anything here.
#
# **Never deploy it as a symlink.** What this system recovers is the workspace
# mount, so linking the configuration to a canonical copy inside that mount would
# make the means of recovery vanish the moment the mount goes away. It must be a
# real file. (The same logic as keeping the host git configuration a real file
# rather than a symlink.)
#
# A shell sources it, so it follows bash syntax. Quote values containing spaces.

#===============================================================================
# Required — host (macOS)
#===============================================================================

# The local account that owns the workspace. It need not have the same name as the
# SMB authentication account, but it is the basis of mount ownership determination
# (`mounted by <this value>`), so it must be a real login account.
# If this account does not exist, the scripts fail immediately rather than falling
# through to a default.
SMBG_OWNER="youraccount"

# Mount point on the host. Must match the key of the autofs direct map
# (/etc/auto_smb). On macOS /opt is a firmlink, so it works without synthetic.conf
# (check: grep -w opt /usr/share/firmlinks).
SMBG_MP="/opt/workspace"

# The ~/.ssh/config alias of the guest (the file server). The wake hook sshes to
# this alias to correct the clock, so it must be registered **in the owner
# account's ssh configuration** (the hook runs as root but switches back with
# `sudo -u <owner> -H`).
#
# Caution: if the key has a passphrase and relies on ssh-agent, BatchMode fails —
# `sudo -u <owner> -H ssh` does not inherit SSH_AUTH_SOCK. Always check after
# installing:
#   sudo -u <owner> -H ssh -o BatchMode=yes -o ConnectTimeout=3 <this value> 'date +%s'
SMBG_HOST="fileserver"

# SMB share name. It is both Samba's [section name] and the first path component of
# the mount URL.
SMBG_SHARE="workspace"

# Path appended after the share name in the mount URL (optional, empty by default).
#
# **Used in the layout that puts the share root one level above the workspace.**
# Samba has a defect where, on file deletion, it clears alternate data streams and
# resolves the basename relative to the share root, so an existing file whose
# basename matches a name at the share root cannot be overwritten or deleted
# anywhere in the tree. `.git/config` gets caught by this and git breaks
# (docs/failure-model.md).
#
# Raising the share root and mounting a subdirectory of it empties the collision
# set, and the layout the client sees is unchanged. Pairs with the guest-side
# SMBG_EXPORT_ROOT.
#   SMBG_SHARE="ws" + SMBG_SHARE_SUBPATH="workspace"
#     -> //account@host/ws/workspace  (the share root is the guest's /srv/ws)
#SMBG_SHARE_SUBPATH="workspace"

# SMB authentication account. Set it here when it differs from the local owner
# account (defaults to SMBG_OWNER). Mount ownership determination uses SMBG_OWNER
# and server authentication uses this value — mixing the two produces the
# misdiagnosis of reading `//account@host/share` as ownership.
#SMBG_SMB_USER="youraccount"

#===============================================================================
# Required — guest (Linux, the Samba server side)
#===============================================================================

# The workspace's real path inside the guest. This is the root of the cruft cleanup
# (the deep sweep). It need not equal the host's SMBG_MP — they are paths on
# different filesystems.
SMBG_GUEST_ROOT="/srv/workspace"

# The share root Samba exports (optional, defaults to SMBG_GUEST_ROOT).
#
# Pairs with SMBG_SHARE_SUBPATH above. Point it **one level above** the workspace
# and bind mount the workspace so it appears beneath it:
#   sudo install -d -o <owner> -g <owner> -m 755 /srv/ws /srv/ws/workspace
#   echo '/srv/workspace /srv/ws/workspace none bind,x-systemd.requires-mounts-for=/srv/workspace 0 0' \
#     | sudo tee -a /etc/fstab
#
# Put nothing but the workspace here — any name that appears at the share root
# becomes an "irreplaceable basename across the whole tree".
#
# The cruft cleanup sweeps this path at depth 1 as well, because the Finder creates
# .Trashes, .Spotlight-V100 and friends **at the root of the mounted share**.
#SMBG_EXPORT_ROOT="/srv/ws"

#===============================================================================
# Optional — leave alone if the defaults are enough
#===============================================================================

# Repo checkout path (optional). The deployed doctor
# (/usr/local/sbin/smb-guard-doctor) uses it to find the repo for its drift
# comparisons when it is not being run from the repo itself. The repo normally
# lives inside the workspace mount, so when the mount is down those comparisons
# are skipped — by design: the doctor's core checks must not depend on the very
# thing it diagnoses, which is also why the doctor is deployed to APFS at all.
#SMBG_REPO="/opt/workspace/config/smb-guard"

# launchd Label prefix. The plist filenames and the Labels are both generated from
# this value. Using an organisation's reverse-DNS name is conventional.
#SMBG_LABEL_PREFIX="io.stewardlabs"

# Unified log directory. The newsyslog rotation configuration is generated for this
# path too.
#SMBG_LOGDIR="/var/log/smb"

# Upper bound (seconds) for the autofs trigger (a directory open). This value only
# means anything if the map carries the `soft` option — on a hard mount an absent
# server means waiting forever.
#SMBG_TRIGGER_TIMEOUT=15

# Spurious-wake gate (seconds). A wake that slept less than this is treated as a
# sleep-transition darkwake and handling is skipped entirely.
#SMBG_SLEEP_GATE=30

# Optional user hook to open in the owner's GUI session at wake. For things
# unrelated to this system that you nonetheless want handled at wake time, such as
# an app that mounts local volumes. It runs only if the path exists, and is a no-op
# when empty.
#SMBG_WAKE_USER_HOOK="/Users/youraccount/bin/mount-local-volume.app"

#-------------------------------------------------------------------------------
# Guest cruft cleanup (mac-cruft-cleanup)
#
# These two are the only values without the SMBG_ prefix — by convention they are
# used as one-off overrides when running the script by hand:
#   PRUNE_NAMES=".git" sudo -E mac-cruft-cleanup
#-------------------------------------------------------------------------------

# .Trashes grace period (days). A trash you cannot undo is not a trash, so nothing
# is deleted immediately.
#TRASH_AGE_DAYS=7

# Directory **names** to skip wholesale during the sweep (names, not paths, so it
# applies regardless of depth). Every .git and every build artefact is excluded
# automatically even when the workspace holds several repositories.
# .Trashes is handled by a separate grace policy, so do not remove it from the list.
#PRUNE_NAMES=".git .Trashes target node_modules"
