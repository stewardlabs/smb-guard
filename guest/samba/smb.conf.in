#===============================================================================
# /etc/samba/smb.conf — workspace share (template)
#
# install.sh substitutes the configuration values. **It is not deployed
# automatically by default** — overwriting an existing smb.conf wholesale would
# lose settings unrelated to this share. Deployment requires an explicit
# `guest/install.sh --samba`, and even then the existing file is backed up.
# Otherwise the substituted result is printed so you can merge just what you need.
#
# Revised per the §8 decisions of handoff v17. Three changes against v16:
#
#   1) veto files / delete veto files  ......  abolished
#      The macOS Finder's CopyEngine treats a failed .DS_Store write as "a fatal
#      error for the entire copy operation" -> the whole copy fails with Finder
#      error code -8062.
#      Blocking .Trashes was also a latent bug that broke "Move to Trash".
#      Blocking (deny) is not this layer's remedy — what is wanted is "cleanliness
#      of the resulting state", and the remedy for that is post-hoc cleanup
#      (§9, Principle 26).
#      -> mac-cruft-cleanup.timer (post-hoc cleanup) + git ignore (blocking history
#         pollution) satisfy the same requirement without breaking the Finder.
#
#   2) fruit:resource = file  ..............  made explicit
#      It is the default, but the intent is recorded in the file. Sending it via
#      streams_xattr (=stream) would inherit ext4's xattr size limit (inode slack
#      plus one block, typically 4KB) and make writes fail for large resource
#      forks — the same shape as the -8062 being fixed here.
#
#   3) rationale comments  .................  added
#      When the rationale is gone, the policy is up for review too (§9, Principle 5).
#
# One v18 change:
#
#   4) path = @EXPORT_ROOT@  ...............  share root moved above the workspace
#      When deleting a file, Samba 4.23.6 clears alternate data streams via
#      delete_all_streams(), and that path uses **only the basename** rather than
#      the full relative path, resolving it against the share root. If a name of
#      the same basename exists at the share root, it opens the wrong object and
#      fails, and that failure surfaces to the client as ENOENT.
#      -> **An existing file whose basename matches an entry name at the share root
#         cannot be overwritten or deleted anywhere in the tree.** `.git/config`
#         gets caught by this and git breaks.
#      Putting the share root one level above the workspace empties the collision
#      set. The client mounts a subdirectory of the share, so the layout it sees is
#      unchanged. Details and measurements in docs/failure-model.md.
#
# Operational contract: if cruft becomes a problem again, **fix the cleanup side.**
#            Restoring veto is a reintroduction of -8062.
#            Put nothing but the workspace at the share root — any name that
#            appears there becomes an "irreplaceable basename across the whole
#            tree".
#
# To apply:  testparm -s            (syntax check, 0 errors)
#            systemctl restart smbd
#            testparm -s 2>/dev/null | grep -E '^\s*veto files'   -> must be 0 lines
#
#            Caution: do not check with grep -i veto. It would match
#            fruit:veto_appledouble = no because of the name, but that line is not
#            a block — it lifts one, and it must stay (see the comment below).
#===============================================================================

[global]
#--- Protocol and macOS interoperability ---------------------------------------
   server min protocol = SMB3
   ea support = yes
   spotlight = no

#--- Printers disabled (not a share target) ------------------------------------
   load printers = no
   printing = bsd
   printcap name = /dev/null

#--- Server identity -----------------------------------------------------------
   workgroup = WORKGROUP
   disable netbios = yes
   server string = %h server (Samba, Ubuntu)
   server role = standalone server

#--- Logging -------------------------------------------------------------------
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d

#--- Authentication ------------------------------------------------------------
   obey pam restrictions = yes
   unix password sync = yes
   passwd program = /usr/bin/passwd %u
   passwd chat = *Enter\snew\s*\spassword:* %n\n *Retype\snew\s*\spassword:* %n\n *password\supdated\ssuccessfully* .
   pam password change = yes

   map to guest = bad user
   usershare allow guests = yes


[@SHARE@]
# This is the level above the workspace, not the workspace itself (header item
# v18). The client mounts the subdirectory as
# `//<account>@<host>/@SHARE@/<workspace name>`.
   path = @EXPORT_ROOT@
   valid users = @SMB_USER@
   read only = no
   browseable = yes

#--- Case ----------------------------------------------------------------------
# git is case-sensitive, so the server is too.
# Its actual effect on Mac clients is still unverified (handoff §11).
   case sensitive = yes
   preserve case = yes
   short preserve case = yes

#--- Permissions ---------------------------------------------------------------
   create mask = 0644
   directory mask = 0755

# When no, DOS attributes get mapped onto the execute bit and pollute it.
   store dos attributes = yes

#--- macOS extensions (vfs_fruit) ----------------------------------------------
   vfs objects = catia fruit streams_xattr
   fruit:model = MacSamba
   fruit:posix_rename = yes
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

# FinderInfo and DOS attributes -> xattr (instead of ._* files).
# They are tens of bytes, so ext4's xattr limit is irrelevant.
# git does not track xattrs, so what accumulates here does not pollute history.
   fruit:metadata = stream

# Resource forks are not sent through xattrs (the v17 judgement — header item 2).
# Same as the default, but the intent is stated.
   fruit:resource = file

# Do not veto ._*. The name contains "veto" but this is not part of the veto files
# family, and no = lifting the block. The default yes stops clients from reaching
# the ._* files fruit creates, and the vfs_fruit(8) manual lists "unpacking Mac ZIP
# archives fails on Mac clients" as a side effect of that — the same failure
# structure as the .DS_Store -8062.
# This option only applies when fruit:resource = file (per the manual), so it has
# had any effect only since v17, where file was made explicit above. Do not set it
# back to yes.
   fruit:veto_appledouble = no

# Prevents misbehaviour from the Finder's chown/chmod attempts
   fruit:nfs_aces = no

#--- No veto (v17) -------------------------------------------------------------
# Do not put veto files here. With it, every Finder copy fails with -8062.
# Reclamation of macOS cruft (.DS_Store, ._*, .TemporaryItems, .Trashes ...) is
# handled by
#   /usr/local/sbin/mac-cruft-cleanup  +  mac-cruft-cleanup.timer
# History pollution is blocked by git's ignore layers.
