# /etc/chrony/conf.d/local-pool.conf   (an example — change it to your own region)
#
# A nearby source. When the distribution's default pool is geographically distant,
# RTT and reachability suffer.
#
# maxpoll 6 (64 seconds) is the worst-case recovery time of the fallback when
# clockfix has failed. With the default of 1024 seconds the clock can stay wrong for
# 17 minutes after a wake.
# Adding maxpoll 6 to the distribution's default pool line is recommended for the
# same reason.
pool kr.pool.ntp.org iburst maxsources 3 maxpoll 6
