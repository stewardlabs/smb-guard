# /etc/systemd/system/mac-cruft-cleanup.timer

[Unit]
Description=Run macOS cruft cleanup every 15 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=1min

# Caution: Persistent= is for OnCalendar only. On a monotonic timer it is silently
# ignored, leaving nothing but the false impression that "missed runs are caught
# up" — so it is not set here.
# One run happens 5 minutes after boot, which already covers downtime.

[Install]
WantedBy=timers.target
