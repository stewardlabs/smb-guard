# /etc/systemd/system/mac-cruft-cleanup.service
#
# The post-hoc cleanup that replaces `veto files` in smb.conf (docs/decisions.md).
# Being cleanup rather than blocking, a failure of this unit leaves the client
# working normally.
#
# This file is a template. install.sh substitutes the workspace paths and deploys
# it — systemd does not expand environment variables in ConditionPathIsDirectory=
# or ReadWritePaths=, so those paths have to be baked in at deployment time.

[Unit]
Description=Purge macOS Finder cruft from the SMB workspace
ConditionPathIsDirectory=@GUEST_ROOT@

[Service]
Type=oneshot
# The second argument is the SMB share root. When the share root sits above the
# workspace, the Finder creates its cruft (.Trashes, .Spotlight-V100, .fseventsd,
# .DS_Store) **at the share root**, which is outside the workspace and would never
# be swept using the first argument alone.
# When the two values are equal the script skips the shallow sweep.
ExecStart=/usr/local/sbin/mac-cruft-cleanup @GUEST_ROOT@ @EXPORT_ROOT@

# Keep the 15-minute find from disturbing builds. This job may finish whenever.
Nice=10
IOSchedulingClass=idle

# Touch nothing but the workspace and the share root.
# **If the share root is missing here, deletions in the shallow sweep fail
# silently** — ProtectSystem=strict makes any path not in ReadWritePaths read-only.
# Fixing only the script is not enough.
ProtectSystem=strict
ReadWritePaths=@GUEST_ROOT@ @EXPORT_ROOT@
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
