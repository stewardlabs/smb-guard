#!/bin/bash
# /usr/local/sbin/mac-cruft-cleanup
#
# Periodically reclaims the cruft that the macOS Finder leaves on an SMB share.
# Replaces `veto files` in smb.conf — the 'abolish blocking' decision in
# docs/decisions.md.
#
# v1.2: split the sweep exclusion list out into PRUNE_NAMES and included build
#       artefacts by default. A workspace root is often not a single repository
#       but **a tree with several repositories at various depths**. Every
#       repository has its own target/, so most of the sweep cost was build
#       artefacts — in a measured sample, 714 of 733 entries were under target/
#       or node_modules/ (97%).
#       Leaving the .DS_Store files inside them costs effectively nothing: build
#       artefacts are already covered by the global git ignore, so they do not
#       pollute history, and they disappear with cargo clean. It was a sweep with
#       cost and no benefit.
#       Note: if a source tree happens to contain a directory literally named
#       'target', cruft inside it is also left behind. Harmless (it is covered by
#       the global ignore), but drop target from PRUNE_NAMES if it bothers you.
# v1.1: added .DocumentRevisions-V100 to the directory reclamation list — aligns
#       the target set with the canonical global git ignore. No logic change.
#
# Why cleanup rather than blocking:
#   The Finder's CopyEngine treats a failed .DS_Store write as a fatal error for
#   the entire copy operation (-8062). Blocking it at the server kills the
#   Finder's primary function. What is wanted is "cleanliness of the resulting
#   state", and the remedy for that is post-hoc cleanup (§9, Principle 26).
#   Cleanup breaks nothing when it fails — that is the decisive difference from
#   blocking.
#
# Output convention:
#   Prints nothing when zero items were removed (the log stays quiet).
#   For one or more, emits a one-line summary on stdout → systemd collects it into
#   journald.
#   That one line is the observation channel of §6: a large .DS_Store count every
#   time signals that the Mac's DSDontWriteNetworkStores suppression is not in
#   effect (not a functional failure).
#   **Caution (Principle 25)**: silence because there was nothing to reclaim and
#   silence because of a fault are indistinguishable in the output. When
#   demonstrating this, run it with targets deliberately left in place.
#
# usage: mac-cruft-cleanup [workspace_path] [share_root_path]
#   Paths are resolved in the order: argument > SMBG_GUEST_ROOT / SMBG_EXPORT_ROOT
#   in /etc/smb-guard.conf.
#   **No default path is hardcoded** — failing beats sweeping and deleting in the
#   wrong tree.
#
#   The second path (the share root) may sit above the workspace. The Finder
#   creates cruft **at the root of the mounted share**, so raising the share root
#   raises the cruft with it, out of reach of a workspace-only sweep. Hence the
#   share root gets one extra sweep at depth 1 — the traversal cost is
#   effectively zero, and when the two values are equal (an existing deployment
#   that did not raise the share root) this sweep is skipped entirely.
#
#   Environment variables (they take precedence over the configuration file — for
#   one-off overrides):
#     TRASH_AGE_DAYS=7                    .Trashes grace period
#     PRUNE_NAMES=".git .Trashes target node_modules"
#                                         Directory names to skip wholesale during
#                                         the sweep. Matched by **name**, not by
#                                         path, so it applies regardless of depth —
#                                         in a multi-repository layout every .git
#                                         and target is excluded automatically.
#                                         .Trashes is handled by a separate policy
#                                         in 3) below, so do not remove it from
#                                         the list.
#
# Idempotent. Can be run by hand. Runs as root.

set -uo pipefail

# Preserve the environment overrides first so they win over the configuration
# file. (The configuration file is sourced, so leaving them would let it
# overwrite the environment variables.)
_env_trash="${TRASH_AGE_DAYS:-}"
_env_prune="${PRUNE_NAMES:-}"

SMBG_CONF="${SMBG_CONF:-/etc/smb-guard.conf}"
[ -r "$SMBG_CONF" ] && . "$SMBG_CONF"

ROOT="${1:-${SMBG_GUEST_ROOT:-}}"
if [ -z "$ROOT" ]; then
    echo "usage: mac-cruft-cleanup <workspace_path> [share_root_path]" >&2
    echo "       (or set SMBG_GUEST_ROOT in $SMBG_CONF)" >&2
    exit 2
fi

# Share root. Falls back to the workspace itself when unspecified, in which case
# 4) below is skipped.
EXPORT_ROOT="${2:-${SMBG_EXPORT_ROOT:-$ROOT}}"

TRASH_AGE_DAYS="${_env_trash:-${TRASH_AGE_DAYS:-7}}"
PRUNE_NAMES="${_env_prune:-${PRUNE_NAMES:-.git .Trashes target node_modules}}"

if [ ! -d "$ROOT" ]; then
    echo "mac-cruft-cleanup: '$ROOT' does not exist — aborting" >&2
    exit 1
fi

# Assemble PRUNE_NAMES into a find expression:
#   ( -type d ( -name A -o -name B ... ) ) -prune -o
PRUNE=( '(' -type d '(' )
_first=1
for _n in $PRUNE_NAMES; do
    if [ "$_first" -eq 1 ]; then _first=0; else PRUNE+=( -o ); fi
    PRUNE+=( -name "$_n" )
done
PRUNE+=( ')' ')' -prune -o )

# 1) Files — reclaimed immediately
#    ._*   : AppleDouble (a product of fruit:resource = file). Files that actually
#            carry a resource fork effectively do not exist in this workspace
#            (Rust/git).
#
#    Why not -delete: GNU find's -delete turns on -depth automatically, and with
#    -depth on, -prune is disabled (find refuses outright). Sweep exclusion is not
#    negotiable, so deletion goes through -exec rm. Confirmed by measurement on 08-14.
n_file=$(find "$ROOT" -xdev "${PRUNE[@]}" \
    -type f '(' -name '.DS_Store' -o -name '._*' -o -name '.apdisk' ')' \
    -print -exec rm -f -- '{}' + 2>/dev/null | wc -l)

# 2) Directories — reclaimed wholesale
#    -prune is applied to a matched directory first, to stop find from descending
#    into a directory it has just deleted and emitting errors.
n_dir=$(find "$ROOT" -xdev "${PRUNE[@]}" \
    -type d '(' -name '.TemporaryItems' -o -name '.fseventsd' \
              -o -name '.Spotlight-V100' -o -name '.DocumentRevisions-V100' \
              -o -name '.AppleDouble'    -o -name '.AppleDB' \
              -o -name '.AppleDesktop' ')' \
    -prune -print -exec rm -rf -- '{}' + 2>/dev/null | wc -l)

# 3) .Trashes — not deleted immediately.
#    A trash you cannot undo is not a trash. If the Finder's "Move to Trash"
#    becomes an effective immediate delete, the user cannot trust it (§8 v17).
#    mindepth/maxdepth 2 = .Trashes/<uid>/<item>. The uid directory itself is kept.
#
#    **The Finder creates .Trashes at the root of the mounted share.** Back when
#    the share root was $ROOT this was the only place to look, but since the share
#    root moved above the workspace, $EXPORT_ROOT has to be looked at too — hence
#    this is factored into a function and reused in 4).
trash_sweep() {   # trash_sweep <root> → prints the reclaimed count on stdout
    if [ ! -d "$1/.Trashes" ]; then echo 0; return; fi
    find "$1/.Trashes" -xdev -mindepth 2 -maxdepth 2 \
        -mtime "+${TRASH_AGE_DAYS}" \
        -print -exec rm -rf -- '{}' + 2>/dev/null | wc -l
}
n_trash=$(trash_sweep "$ROOT")

# 4) Share root — swept at depth 1 only.
#    If the share root was not raised ($EXPORT_ROOT == $ROOT) everything was
#    already swept above, so skip. Duplicate deletion would be harmless but would
#    double-count the totals.
#
#    With -maxdepth 1 the traversal cost is effectively zero. -xdev stops at the
#    boundary when the workspace is bind-mounted as a separate filesystem — a
#    second safeguard alongside the depth limit.
#
#    Caution: for this sweep to actually delete anything, the share root must be
#    in the systemd unit's ReadWritePaths. Under ProtectSystem=strict a path not
#    listed there is read-only, and the deletion failure is silently swallowed
#    here (2>/dev/null).
n_export=0
if [ "$EXPORT_ROOT" != "$ROOT" ] && [ -d "$EXPORT_ROOT" ]; then
    n_e_file=$(find "$EXPORT_ROOT" -xdev -maxdepth 1 \
        -type f '(' -name '.DS_Store' -o -name '._*' -o -name '.apdisk' ')' \
        -print -exec rm -f -- '{}' + 2>/dev/null | wc -l)

    n_e_dir=$(find "$EXPORT_ROOT" -xdev -mindepth 1 -maxdepth 1 \
        -type d '(' -name '.TemporaryItems' -o -name '.fseventsd' \
                  -o -name '.Spotlight-V100' -o -name '.DocumentRevisions-V100' \
                  -o -name '.AppleDouble'    -o -name '.AppleDB' \
                  -o -name '.AppleDesktop' ')' \
        -print -exec rm -rf -- '{}' + 2>/dev/null | wc -l)

    n_e_trash=$(trash_sweep "$EXPORT_ROOT")
    n_export=$(( n_e_file + n_e_dir + n_e_trash ))
fi

total=$(( n_file + n_dir + n_trash + n_export ))

if [ "$total" -gt 0 ]; then
    _export_note=""
    [ "$n_export" -gt 0 ] && _export_note=" / share root ${n_export} @ ${EXPORT_ROOT}"
    echo "mac-cruft-cleanup: removed ${total}" \
         "(files ${n_file} / dirs ${n_dir} / trash ${n_trash}, grace ${TRASH_AGE_DAYS}d)" \
         "@ ${ROOT}${_export_note}"
fi

exit 0
