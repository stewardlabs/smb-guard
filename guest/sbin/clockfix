#!/bin/sh
# /usr/local/sbin/clockfix
# usage: clockfix <epoch_seconds[.frac]>   (only ever run as root — a sudoers NOPASSWD target)
#
# Right after a hypervisor guest resumes, sets its clock to the host's authority
# immediately. Continuous correction while awake is the NTP daemon's (chrony) job;
# this tool handles only the coarse step.
#
#   - Accepts a fractional epoch — the host hook sends a μs-precision value via
#     perl. An integer is accepted as-is (fallback compatibility). GNU date
#     supports "@sec.frac".
#   - chronyc online after the step — brings back NTP sources that the dispatcher
#     took offline during sleep (measured: left offline for 1h11m). chronyd
#     detects the step itself and resets its history, so burst/makestep are
#     unnecessary. clockfix's own job must still work when chrony is absent or
#     stopped, so the failure is ignored.
#
# The output format "clockfix: ..." is a logging convention — the hook records it
# verbatim rather than adding a prefix (Principle 14: a layer prefix is attached
# in exactly one place).
case "$1" in
    ''|.|*[!0-9.]*|.*|*.|*.*.*) echo "usage: clockfix <epoch_seconds[.frac]>" >&2; exit 1 ;;
esac
before=$(date +%s.%N)
date -s "@$1" >/dev/null
echo "clockfix: ${before} -> $(date +%s.%N) ($(date '+%F %T %Z'))"
command -v chronyc >/dev/null 2>&1 && chronyc online >/dev/null 2>&1 || true
exit 0
