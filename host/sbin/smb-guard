#!/bin/bash
# /usr/local/sbin/smb-guard
# Owner watch and remediation for the workspace smbfs mount — the sole
# remediation agent. The target mount point and owner come from the
# configuration file (/usr/local/etc/smb-guard.conf).
#
# Modes, by invocation path:
#   (none)     watch   : LaunchDaemon(StartOnMount). Remediates FOREIGN only. Never creates a mount.
#   --ensure   ensure  : smb-guard-wakeup. Includes an owner trigger when absent.
#   --remount  remount : smbfix. Forced remount regardless of state (for a dead mount).
#   --state    state   : print the determination and exit. No side effects (debug/scripting).
#
# Design principles (inherited from handoff document §8):
#   - Determination reads the mount table only (smbg_state, common.sh).
#   - The only trigger is one deliberate directory open (ls), and it always runs
#     with the owner's credentials.
#   - Remediation in watch mode produces a new mount event and thus re-fires this
#     script, but the re-fired instance sees HEALTHY and exits immediately, so the
#     loop terminates.
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

MODE="watch"
case "${1:-}" in
  --ensure)  MODE="ensure"  ;;
  --remount) MODE="remount" ;;
  --state)   MODE="state"   ;;
  "") ;;
  *) echo "usage: smb-guard [--ensure|--remount|--state]" >&2; exit 2 ;;
esac

SMBG_TAG="$MODE"
. /usr/local/lib/smb-guard/common.sh

# Seconds. Presupposes the map's soft option — a missing server still fails
# within finite time. Comes from the configuration file.
TRIGGER_TIMEOUT="$SMBG_TRIGGER_TIMEOUT"
LOCK_WAIT_ENSURE=30  # Seconds. ensure/remount must not back off silently (see below).

# --state needs no lock either. Handle it first and get out.
if [ "$MODE" = "state" ]; then smbg_state; exit 0; fi

if ! smbg_is_root; then
  echo "smb-guard: root privileges required (sudo smb-guard $*)" >&2
  exit 2
fi

# ── Locking ────────────────────────────────────────────────────────────────
# Ghost-lock sweep: when an instance dies from SIGKILL or the like the EXIT trap
# never runs, the lock directory survives forever, and from then on the whole of
# guard goes silent (an asymptomatic failure). A lock older than a generous
# multiple of the worst-case trigger time is treated as cruft.
if [ -d "$SMBG_LOCKDIR" ]; then
  _now=$(date +%s)
  _age=$(( _now - $(stat -f %m "$SMBG_LOCKDIR" 2>/dev/null || echo "$_now") ))
  if [ "$_age" -gt 120 ]; then
    log "removing stale lock (${_age}s) — cruft from a dead instance"
    rmdir "$SMBG_LOCKDIR" 2>/dev/null
  fi
fi

acquire_lock() {
  local tries="$1" i=0
  while ! mkdir "$SMBG_LOCKDIR" 2>/dev/null; do
    i=$((i+1))
    [ "$i" -ge "$tries" ] && return 1
    sleep 1
  done
  trap 'rmdir "$SMBG_LOCKDIR" 2>/dev/null' EXIT
  return 0
}

if [ "$MODE" = "watch" ]; then
  # StartOnMount fires repeatedly (remediation itself produces an event).
  # An instance that cannot take the lock backs off silently — another instance
  # is already handling it.
  acquire_lock 1 || exit 0
else
  # For ensure/remount the caller (wakeup, smbfix) trusts the result.
  # A silent exit 0 here would mean "succeeded without doing anything", i.e. a
  # false positive.
  if ! acquire_lock "$LOCK_WAIT_ENSURE"; then
    log "lock timeout (${LOCK_WAIT_ENSURE}s) — another instance holds it"
    exit 1
  fi
fi

# ── Remediation primitives (exist only in this file) ───────────────────────
# Logging principle: never let subcommand output flow through verbatim. Carry it
# all inside log()'s tag, and **mark expected failures as "expected"**. Otherwise
# the fallback chain reads as a contradiction (08-08 scenario A: "umount failed →
# unmount succeeded → ls failed → remediation complete").

force_umount() {
  local out rc
  # Stage 1: via DiskArbitration. diskutil does not unmount by itself but
  # delegates to diskarbitrationd (a system daemon), so it is **independent of
  # the caller's TCC privileges**. The autofs trigger point is also released in
  # cooperation with automountd. In the hook context this stage effectively
  # always finishes the job.
  out="$(diskutil unmount force "$SMBG_MP" 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    log "diskutil unmount force succeeded → state=$(smbg_state)"
    return 0
  fi
  log "diskutil unmount force failed → falling back to umount -f: $(smbg_oneline "$out")"

  # Stage 2: direct kernel call. A safety net for when diskarbitrationd does not
  # respond. It fails with EPERM in a daemon context (Layer 4b, measured 08-08).
  # **Cause undetermined** — it is not TCC/FDA (it succeeds from Terminal.app
  # without FDA). The remaining candidates are the execution context (launchd
  # system domain vs login session) and the target mount's owner.
  # Where it does have effect is the smbfix path, which runs from a terminal.
  # Through v14.2 this call was stage 1, failing on every hook run and polluting
  # the log.
  out="$(umount -f "$SMBG_MP" 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    log "umount -f succeeded → state=$(smbg_state)"
    return 0
  fi
  log "umount -f failed too: $(smbg_oneline "$out") — state=$(smbg_state), continuing"
  return 1
}

trigger_as_owner() {
  # Only a directory open triggers autofs (not getattrlist/stat64/fsctl —
  # measured 08-07).
  # ls's exit code and output are not used for determination. Even when TCC
  # denies readdir (EPERM), open() has already happened and automountd completes
  # the mount — demonstrated by scenario A on 08-08.
  # smbg_in_session (launchctl asuser) secures the user's Mach bootstrap context.
  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/smbg-trigger.XXXXXX")"
  smbg_in_session /bin/ls "$SMBG_MP" >/dev/null 2>"$tmp" &
  local pid=$! waited=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1; waited=$((waited+1))
    if [ "$waited" -ge "$TRIGGER_TIMEOUT" ]; then
      kill "$pid" 2>/dev/null
      log "trigger timeout (${TRIGGER_TIMEOUT}s) — server may not be responding"
      rm -f "$tmp"; return 1
    fi
  done

  local err; err="$(smbg_oneline "$(cat "$tmp" 2>/dev/null)")"; rm -f "$tmp"
  case "$err" in
    "") log "trigger ls done (no output) → state=$(smbg_state)" ;;
    *"Operation not permitted"*)
      # Layer 3. In a daemon context without FDA this is normal output — not a failure.
      log "trigger ls EPERM (expected — Layer 3, open already happened) → state=$(smbg_state)" ;;
    *) log "trigger ls output: $err → state=$(smbg_state)" ;;
  esac
  return 0
}

ensure_owner_mount() {
  if ! smbg_session_active; then
    # asuser fails when there is no GUI session. At the logout/login window the
    # trigger is impossible outright, so record the failure explicitly rather
    # than letting it pass silently.
    log "warning: no GUI session for $SMBG_OWNER — cannot trigger autofs"
  fi
  trigger_as_owner || true          # ignore the exit code — determination is smbg_state only
  [ "$(smbg_state)" = "HEALTHY" ] && return 0

  # One retry, after flushing the trigger cache
  log "first trigger did not reach HEALTHY (state=$(smbg_state)) — retrying after automount -vc"
  local out; out="$(automount -vc 2>&1)"
  [ -n "$out" ] && log "automount -vc: $(smbg_oneline "$out")"
  trigger_as_owner || true
  [ "$(smbg_state)" = "HEALTHY" ]
}

# ── Per-mode behaviour ─────────────────────────────────────────────────────
S="$(smbg_state)"

case "$MODE" in
  watch)
    case "$S" in
      HEALTHY) exit 0 ;;   # Silent exit. It fires often, so it does not even log.
      ABSENT)  exit 0 ;;   # watch never creates a mount — that is ensure's job.
      FOREIGN)
        log "FOREIGN detected — starting remediation"
        force_umount
        if ensure_owner_mount; then log "remediation complete → HEALTHY"
        else log "remediation failed — state=$(smbg_state)"; exit 1; fi
        ;;
    esac
    ;;
  ensure)
    case "$S" in
      HEALTHY) log "healthy"; exit 0 ;;
      ABSENT)
        log "absent — triggering with $SMBG_OWNER credentials"
        if ensure_owner_mount; then log "mount complete → HEALTHY"
        else log "mount failed — state=$(smbg_state)"; exit 1; fi
        ;;
      FOREIGN)
        log "FOREIGN — remediating"
        force_umount
        if ensure_owner_mount; then log "remediation complete → HEALTHY"
        else log "remediation failed — state=$(smbg_state)"; exit 1; fi
        ;;
    esac
    ;;
  remount)
    log "forced remount (previous state=$S)"
    force_umount
    if ensure_owner_mount; then log "remount complete → HEALTHY"
    else log "remount failed — state=$(smbg_state)"; exit 1; fi
    ;;
esac
exit 0
