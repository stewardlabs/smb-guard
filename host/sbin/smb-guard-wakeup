#!/bin/bash
# /usr/local/sbin/smb-guard-wakeup
# sleepwatcher -w hook. Right after wake, restores the guest and the SMB mount to
# a usable state.
#
# Clock role split: continuous correction while awake belongs to the guest's NTP
# daemon (chrony); the immediate step right after resume belongs to this hook via
# clockfix. Hypervisor time synchronisation can be mutually exclusive with guest
# NTP (Parallels' prltimesync runs `timedatectl set-ntp 0` at startup), so it is
# assumed to be off — docs/failure-model.md Layer 1.
#
# The clockfix argument is a fractional epoch (μs). macOS date does not support
# %N, so it is obtained via perl -MTime::HiRes. Integer truncation (up to 1s) was
# the dominant error term, so this one change raises precision from ±1s to the
# level of one-way ssh latency (tens of ms). Falls back to an integer when perl
# is unavailable.
#
# Assumes root (system domain) execution. Calls that need user credentials switch
# explicitly:
#     ssh          → smbg_as_owner   (the guest alias and key in ~/.ssh/config must be the owner's)
#     open(1)      → smbg_in_session (needs a GUI session)
#     liveness ls  → smbg_in_session (what is measured is accessibility from the owner's viewpoint)
#   Even if this were moved back to the user domain (LaunchAgent) it would still
#   work, because the wrappers degrade to no-ops.
#
# All determination and remediation of the mount is delegated to smb-guard. This
# script handles only "when to call guard" and the wake-specific observations.
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

T0=$(date +%s)
SMBG_TAG="wakeup"
. /usr/local/lib/smb-guard/common.sh
exec >>"$SMBG_LOG" 2>&1    # Collect leaked stdout/stderr into the same log.
                           # An untagged line is itself the signal that something leaked.

# Deployment path of clockfix on the guest (guest/install.sh installs it there)
GUEST_CLOCKFIX="/usr/local/sbin/clockfix"

# Append elapsed time to the tag → "[wakeup +12s]".
smbg_tag() { printf 'wakeup +%ss' $(( $(date +%s) - T0 )); }

log "=== wakeup start ==="

# ── 0) Spurious-wake gate ──────────────────────────────────────────────────
if [ -r "$SMBG_LAST_SLEEP" ]; then
    slept=$(( T0 - $(cat "$SMBG_LAST_SLEEP") ))
    log "slept for ${slept}s"
    if [ "$slept" -lt "$SMBG_SLEEP_GATE" ]; then
        log "immediate wake (<${SMBG_SLEEP_GATE}s) — judged a sleep-transition darkwake, skipping everything"
        exit 0
    fi
else
    log "no last_sleep record — proceeding"
fi

# Note: observation of the last wake type (pmset -g log) is deliberately NOT here.
#   pmset -g log parses the entire power log and takes **a measured 11 seconds**.
#   Back when this call sat right after the gate, purely observational code pushed
#   the network wait, clockfix and mount assurance all 11 seconds later — the only
#   reason the performance target was missed.
#   The observation is equally valid when collected at the end of the script, so
#   it was moved there.

# ── 1) User hook (optional) ────────────────────────────────────────────────
# Something unrelated to this system that should nonetheless run at wake (an app
# that mounts local volumes, say). A no-op when the setting is empty.
if [ -n "$SMBG_WAKE_USER_HOOK" ] && [ -e "$SMBG_WAKE_USER_HOOK" ]; then
    if smbg_session_active; then
        if [ -d "$SMBG_WAKE_USER_HOOK" ]; then     # .app bundle
            smbg_in_session /usr/bin/open "$SMBG_WAKE_USER_HOOK" \
                || log "user hook open failed: $SMBG_WAKE_USER_HOOK"
        elif [ -x "$SMBG_WAKE_USER_HOOK" ]; then
            smbg_in_session "$SMBG_WAKE_USER_HOOK" \
                || log "user hook execution failed: $SMBG_WAKE_USER_HOOK"
        else
            log "user hook is not executable: $SMBG_WAKE_USER_HOOK"
        fi
    else
        log "no GUI session — skipping user hook"
    fi
fi

# ── 2) Resolve the guest address ───────────────────────────────────────────
# Use the IP from /etc/hosts when present, otherwise pass the hostname straight
# through. nc accepts a hostname too, so the fallback holds. mDNS is not used as
# the primary means because resolution lags right after wake.
#
# Looking at the second field alone is wrong — in the form where aliases follow
# the canonical name (`10.0.0.4  host.domain  host`) the alias sits in the third
# or later field and the match fails. Entries auto-registered by a hypervisor take
# exactly that form. Scan every field.
addr="$(awk -v h="$SMBG_HOST" '{for(i=2;i<=NF;i++) if($i==h){print $1; exit}}' /etc/hosts)"
: "${addr:=$SMBG_HOST}"
log "$SMBG_HOST -> $addr"

# ── 3) Wait for the network (sshd) ─────────────────────────────────────────
i=0
while ! nc -z -G 1 "$addr" 22 >/dev/null 2>&1; do
    i=$((i+1))
    if [ "$i" -ge 30 ]; then
        log "network to $addr:22 not up after ~60s — giving up"
        exit 0
    fi
    sleep 2
done
log "network up"

# ── 4) Check the clock, run clockfix immediately if it has drifted ─────────
guest_ssh() {
    smbg_as_owner ssh -o BatchMode=yes -o ConnectTimeout=3 "$SMBG_HOST" "$@"
}

off=""
for i in 1 2 3; do
    remote="$(guest_ssh 'date +%s' 2>/dev/null)"
    if [[ "$remote" =~ ^[0-9]+$ ]]; then
        off=$(( remote - $(date +%s) ))
        break
    fi
    sleep 1
done

if [ -z "$off" ]; then
    log "WARN: could not read guest clock — proceeding anyway"
elif [ "$off" -ge -2 ] && [ "$off" -le 2 ]; then
    log "clock ok (offset ${off}s)"
else
    log "initial offset: ${off}s — forcing clockfix"
    # Send a fractional epoch. Integer fallback if perl is missing or fails
    # (also compatible with older clockfix).
    now="$(perl -MTime::HiRes=time -e 'printf "%.6f", time' 2>/dev/null || date +%s)"
    # clockfix's output already identifies itself as "clockfix: ...". Adding a
    # prefix would produce "clockfix: clockfix: ...". Record it verbatim
    # (Principle 14).
    guest_ssh "sudo -n $GUEST_CLOCKFIX $now" 2>&1 | while IFS= read -r l; do
        [ -n "$l" ] && log "$l"
    done
    remote="$(guest_ssh 'date +%s' 2>/dev/null)"
    [[ "$remote" =~ ^[0-9]+$ ]] && log "offset after clockfix: $(( remote - $(date +%s) ))s"
fi

# ── 5) Check the smbd port ─────────────────────────────────────────────────
i=0
while ! nc -z -G 1 "$addr" 445 >/dev/null 2>&1; do
    i=$((i+1))
    if [ "$i" -ge 10 ]; then
        log "smbd port not responding — giving up"
        exit 0
    fi
    sleep 2
done

# ── 6) Mount assurance ─────────────────────────────────────────────────────
#       Ownership determination, FOREIGN remediation, creation when absent and
#       flush-and-retry are all unified into smb-guard. guard determines from the
#       mount table alone, so TCC EPERM misdiagnosis is structurally impossible.
if ! smbg_guard --ensure; then
    log "STILL DEAD — guard --ensure failed (smbfix needed)"
    exit 0
fi

# ── 7) Liveness probe — the wake-specific role ─────────────────────────────
#    Ownership has been assured by guard. What happens here is forcing and
#    verifying SMB session re-establishment right after a freeze, and measuring
#    the reconnection delay.
t_ls=$(date +%s)
if err="$(smbg_in_session /bin/ls "$SMBG_MP" 2>&1 >/dev/null)"; then
    log "mount HEALTHY (ls ok, $(( $(date +%s) - t_ls ))s)"
elif [ "${err#*Operation not permitted}" != "$err" ]; then
    log "mount HEALTHY (ls TCC-denied — a limit of the probe context)"
else
    log "mount UNHEALTHY (ls: [$err], $(( $(date +%s) - t_ls ))s) — re-establishing via guard --remount"
    if smbg_guard --remount; then
        log "remounted OK"
    else
        log "STILL DEAD after remount (smbfix needed)"
    fi
fi

# ── 8) Observation: the last wake type ─────────────────────────────────────
#    Kept off the critical path (see the note above). The mount is already usable
#    by this point, so spending 11 seconds here costs no perceived latency.
#    The pmset log is a tab-separated column structure:
#      "time domain(Wake/DarkWake)<tab>details..."
#    Merely squeezing tabs into spaces would join the domain to the first word of
#    the details, reading as "Wake Wake from ...". Replace the tab (the column
#    boundary) with ' — ' to preserve it.
#    The domain value itself is kept — whether it was a DarkWake is primary
#    evidence for Layer 2 determination.
#    pmset's own timestamp is kept too — it has drifted from this point's log()
#    time, and the pair is needed to compare "actual wake time vs hook firing time".
wt="$(pmset -g log 2>/dev/null | grep -E "DarkWake|Wake from" | tail -1 \
      | sed 's/[[:space:]]*\t[[:space:]]*/ — /g' | tr -s ' ' ' ')"
[ -n "$wt" ] && log "last wake event: $wt"

log "=== wakeup end ==="
exit 0
