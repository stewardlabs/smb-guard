#!/bin/bash
# /usr/local/sbin/smbfix
# Manual SMB recovery (for an interactive terminal).
#
# The tool a human reaches for when automatic recovery (the wake hook and the
# mount event hook) has finally failed. It holds no determination or remediation
# logic of its own and delegates to smb-guard — there must be a single
# remediation agent.
#
#   [1/3] guest clock check and fix   [2/3] guard --remount   [3/3] diagnosis
#
# In addition to terminal output it records to the unified log under the [smbfix]
# tag. Manual intervention has to land on the same timeline as the guard and
# wakeup events for after-the-fact tracing to work.
#
# Self-elevating: logging and calling guard require root, so it re-executes itself
# under sudo at startup. ssh and mount_smbfs are switched back to the owner's
# credentials (~/.ssh/config, login keychain).
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

# Elevate if not root. This is interactive, so a password prompt is fine.
if [ "$(id -u)" -ne 0 ]; then
    exec sudo /usr/local/sbin/smbfix "$@"
fi

SMBG_TAG="smbfix"
. /usr/local/lib/smb-guard/common.sh

GUEST_CLOCKFIX="/usr/local/sbin/clockfix"

guest_ssh() {
    smbg_as_owner ssh -o BatchMode=yes -o ConnectTimeout=3 "$SMBG_HOST" "$@"
}

say "=== smbfix start (state=$(smbg_state)) ==="

# ── [1/3] Guest clock check and fix ────────────────────────────────────────
say "[1/3] guest clock check & fix"
remote="$(guest_ssh 'date +%s' 2>/dev/null)"

if [[ "$remote" =~ ^[0-9]+$ ]]; then
    off=$(( remote - $(date +%s) ))
    say "  offset: ${off}s"
    if [ "$off" -gt 2 ] || [ "$off" -lt -2 ]; then
        # Early versions only advised. Then a large-skew situation went straight
        # to remount with the advice skipped, so it was promoted to automatic
        # correction.
        say "  -> |off| > 2s — running clockfix"
        # Fractional epoch (integer fallback if perl is missing — also compatible
        # with older clockfix)
        now="$(perl -MTime::HiRes=time -e 'printf "%.6f", time' 2>/dev/null || date +%s)"
        guest_ssh "sudo -n $GUEST_CLOCKFIX $now"

        remote="$(guest_ssh 'date +%s' 2>/dev/null)"
        if [[ "$remote" =~ ^[0-9]+$ ]]; then
            off2=$(( remote - $(date +%s) ))
            say "  -> offset after correction: ${off2}s"
            if [ "$off2" -gt 2 ] || [ "$off2" -lt -2 ]; then
                say "  !! correction failed — check the sync layers:"
                say "     ssh $SMBG_HOST 'systemctl status chrony; chronyc tracking'"
                say "     ssh $SMBG_HOST 'journalctl --since \"-1h\" | grep -i \"clock change\"'"
                say "     If the hypervisor's guest time synchronisation is on it may be"
                say "     mutually exclusive with guest NTP — docs/failure-model.md Layer 1"
            fi
        fi

        if [ "$off" -gt 300 ] || [ "$off" -lt -300 ]; then
            # Files written during a large skew can carry a future mtime.
            # Build tools with an mtime-based fingerprint (cargo and the like)
            # silently ignore source changes when the artefact is in the future —
            # the hardest kind of failure to find.
            say "  !! corrected a large skew (${off}s). Checking the guest filesystem for future timestamps is advised:"
            say "     ssh $SMBG_HOST 'find $SMBG_GUEST_ROOT -newermt now -printf \"%T+ %p\\n\" 2>/dev/null | head'"
            say "     If found: clear build caches (cargo clean etc.) and check commit times in git log"
        fi
    fi
else
    say "  WARN: ssh unreachable — first check that the guest is running"
fi

# ── [2/3] Remount ──────────────────────────────────────────────────────────
say "[2/3] remount (smb-guard --remount)"
# Determination and remediation logic belongs to smb-guard (umount /
# automount -vc / the trigger loop)
if "$SMBG_GUARD" --remount; then
    say "  remounted OK (mounted by $SMBG_OWNER)"
    exit 0
fi
say "  guard failed (details: $SMBG_LOG)"

# ── [3/3] Diagnosis ────────────────────────────────────────────────────────
say "[3/3] still dead — diagnosing"
probe="/tmp/_smbprobe.$$"
mkdir -p "$probe" && chown "$SMBG_OWNER" "$probe"

# The probe mount must run in the owner's session context — SMB credentials in
# the login keychain are not visible from a root context, which would misdiagnose
# the problem as an authentication failure unrelated to the actual cause.
# Use SMBG_SHARE_PATH, not SMBG_SHARE — the probe only represents the real mount
# if it uses the same path the autofs map mounts (the layout that mounts a
# subdirectory of the share).
err="$(smbg_in_session /sbin/mount_smbfs "//$SMBG_SMB_USER@$SMBG_HOST/$SMBG_SHARE_PATH" "$probe" 2>&1)"
mount | grep -q " on $probe " && umount "$probe" 2>/dev/null
rmdir "$probe" 2>/dev/null

say "  probe: ${err:-probe mount succeeded(!) — the problem is likely on the autofs side}"

if printf '%s' "$err" | grep -qi "too many users"; then
    say "  -> EUSERS wedged (leftover smbfs sessions in the macOS kernel). The only known cure: reboot the server"
    say "    Restart the guest and run smbfix again"
else
    say "  -> check the logs:"
    say "    log show --last 5m --predicate 'process == \"automountd\" OR process == \"mount_smbfs\"' --info"
    say "    log show --last 1h --predicate 'process == \"diskarbitrationd\" AND eventMessage CONTAINS \"$(basename "$SMBG_MP")\"' --info | grep -E 'created|removed'"
fi
exit 1
