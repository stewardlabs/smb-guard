#!/bin/bash
# /usr/local/sbin/smb-guard-sleep
# sleepwatcher -s hook. Fires just before sleep.
#
# It deliberately "records only":
#   1) The time macOS grants a -s hook is short and not guaranteed. Attempting
#      network I/O or an umount here can be cut off by sleep proceeding, and an
#      interrupted umount leaves an even worse intermediate state.
#   2) This system's recovery strategy is "repair on the wake side". The sleep
#      side records only the facts the wake side needs for its decision (the time
#      of the last sleep, and the state at that moment).
#
# Introducing a pre-sleep unmount would need separate consideration, not a change
# here (umount -f on a frozen SMB session can itself block for seconds).
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

SMBG_TAG="sleep"
. /usr/local/lib/smb-guard/common.sh
exec >>"$SMBG_LOG" 2>&1    # Collect leaked stdout/stderr into the same log.
                           # An untagged line is itself the signal that something leaked.

date +%s > "$SMBG_LAST_SLEEP" 2>/dev/null   # for the wake side's spurious-wake gate
log "sleep — state=$(smbg_state)"
exit 0
