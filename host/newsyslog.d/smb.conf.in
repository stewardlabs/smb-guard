# /etc/newsyslog.d/@LABEL_PREFIX@.smb.conf   (root:wheel 644 — otherwise it is ignored)
#
# This file is a template. install.sh substitutes the configuration values and
# deploys it.
#
# size is in KB. The '*' under when means "no time condition = size condition only".
# flags: J = bzip2 compression, G = allow filename globbing
#
# Rotation is generational, not a truncate:
#   smb-guard.log -> smb-guard.log.0.bz2 -> .1.bz2 -> ... -> anything past count is deleted
# That is, the oldest gets pushed out and recent content is preserved.
#
# logfilename                            [owner:group]  mode  count  size  when  flags
@LOGDIR@/smb-guard.log               root:wheel     644   7      1024  *     GJ
@LOGDIR@/smb-guard.launchd.log       root:wheel     644   4      512   *     GJ
@LOGDIR@/sleepwatcher.launchd.log    root:wheel     644   4      512   *     GJ
