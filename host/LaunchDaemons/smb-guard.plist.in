<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- /Library/LaunchDaemons/@LABEL_PREFIX@.smb-guard.plist (root:wheel 644)

	     This file is a template. install.sh substitutes the configuration values
	     and deploys it — never copy a file that still has placeholders in it.

	     It fires on every filesystem mount event on the system.
	     smb-guard (watch mode) exits immediately at its first determination for
	     anything but the target mount, so an unrelated mount such as a USB stick
	     costs one mount table lookup and nothing else.

	     Core coverage: the very moment a root process such as backupd creates a
	     root-owned smbfs mount is a mount event, so this fires the instant
	     hijacking happens and remediates it.

	     RunAtLoad: runs once when the daemon is loaded (including at boot) to clean
	     up any FOREIGN that appeared while the daemon was absent. Being watch mode,
	     it does not create a new mount.

	     What is watched is not a particular mount but **every mount event**. The
	     target determination is made by the script from the mount table, so no path
	     is hardcoded here. -->
	<key>Label</key>
	<string>@LABEL_PREFIX@.smb-guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/smb-guard</string>
	</array>
	<key>StartOnMount</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<!-- The remediation sequence (umount -> trigger) can chain events, so a
	     re-execution interval is imposed. A second line of defence alongside the
	     script's own mkdir lock. -->
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<!-- Collect stdout and stderr into the same file. Some tools emit errors on
	     stdout, and without StandardOutPath that evidence vanishes into /dev/null
	     (Principle 3: base determination on primary evidence).
	     Failures before the script reaches its exec redirection (a bad shebang, for
	     instance) also land here. -->
	<key>StandardOutPath</key>
	<string>@LOGDIR@/smb-guard.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>@LOGDIR@/smb-guard.launchd.log</string>
</dict>
</plist>
